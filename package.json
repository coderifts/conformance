{
  "name": "@coderifts/conformance",
  "version": "0.5.0",
  "description": "Offline CodeRifts adapter-acceptance + model-acceptance suite. No network, no API key.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "conformance": "bin/coderifts-conformance.js"
  },
  "main": "./bin/coderifts-conformance.js",
  "files": [
    "bin/",
    "lib/",
    "subjects/",
    "fixtures/",
    "cases.v1.json",
    "CONTRACT.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node bin/coderifts-conformance.js --subject reference && node bin/coderifts-conformance.js --subject sdk && node bin/coderifts-conformance.js --subject agent-guard && node bin/coderifts-conformance.js --subject model-acceptance && node bin/coderifts-conformance.js --subject data-plane && node --test test/*.test.js",
    "conformance": "node bin/coderifts-conformance.js",
    "model-acceptance": "node bin/coderifts-conformance.js --subject model-acceptance",
    "profiles": "node bin/coderifts-conformance.js --profiles",
    "release:check": "node scripts/assert-changelog-version.js",
    "prepublishOnly": "npm run release:check && npm test"
  },
  "dependencies": {
    "@coderifts/agent-guard": ">=8.1.1",
    "@coderifts/sdk": ">=1.1.1"
  },
  "optionalDependencies": {
    "capability-demo": "git+https://github.com/coderifts/capability-demo.git#b52def10defe59fb4204649ef67cd6a2ce070a68"
  },
  "coderifts": {
    "capability_demo": {
      "package": "capability-demo",
      "git": "https://github.com/coderifts/capability-demo.git",
      "commit": "b52def10defe59fb4204649ef67cd6a2ce070a68",
      "src": "demo/src",
      "sibling": "../capability-demo"
    }
  },
  "keywords": [
    "coderifts",
    "conformance",
    "adapter-acceptance",
    "execution_action",
    "agent-guard",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderifts/conformance.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
