{
  "version": 1,
  "title": "CodeRifts adapter acceptance cases",
  "description": "Language-agnostic cases for every consumer of a governance decision. Derived from shipped surfaces only \u2014 not from free-form product claims. See CONTRACT.md.",
  "outcomes": [
    "proceed",
    "proceed_with_monitoring",
    "request_approval",
    "halt"
  ],
  "tools": [
    "preflight_change_set",
    "verify_receipt",
    "get_decision_details"
  ],
  "cases": [
    {
      "id": "AA-BRANCH-CONTINUE",
      "kind": "decide",
      "profiles": [
        "normative",
        "enforcement_consistent"
      ],
      "source": {
        "surface": "well-known",
        "path": "recommended_usage.branch_on + recommended_usage.execution_action[0]",
        "assert": {
          "branch_on": "execution_action",
          "execution_action_includes": "CONTINUE"
        }
      },
      "input": {
        "response": {
          "decision": "ALLOW",
          "safe_for_agent": true,
          "execution_action": "CONTINUE"
        },
        "host": {
          "monitoringSinkWired": false
        }
      },
      "expect": {
        "outcome": "proceed"
      },
      "class": "liveness"
    },
    {
      "id": "AA-BRANCH-NOT-DECISION",
      "kind": "decide",
      "profiles": [
        "normative"
      ],
      "note": "decision=ALLOW would proceed if branching on decision; execution_action=STOP must halt. Proves branch_on is execution_action.",
      "source": {
        "surface": "well-known",
        "path": "recommended_usage.branch_on",
        "assert": {
          "branch_on": "execution_action"
        }
      },
      "input": {
        "response": {
          "decision": "ALLOW",
          "safe_for_agent": true,
          "execution_action": "STOP"
        },
        "host": {
          "monitoringSinkWired": true
        }
      },
      "expect": {
        "outcome": "halt"
      },
      "class": "safety"
    },
    {
      "id": "AA-BRANCH-NOT-SAFE-FOR-AGENT",
      "kind": "decide",
      "profiles": [
        "normative"
      ],
      "note": "safe_for_agent=false is dashboard-only per well-known; execution_action=CONTINUE still proceeds under pure branch_on. Liveness: adapters MAY halt if they DECLARE conjunct safe_for_agent_false and demonstrate it (see strictness_allowed).",
      "source": {
        "surface": "well-known",
        "path": "recommended_usage.safe_for_agent",
        "assert": {
          "safe_for_agent": "not_for_control_flow_use_execution_action"
        }
      },
      "input": {
        "response": {
          "decision": "ALLOW",
          "safe_for_agent": false,
          "execution_action": "CONTINUE"
        },
        "host": {
          "monitoringSinkWired": false
        }
      },
      "expect": {
        "outcome": "proceed"
      },
      "class": "liveness",
      "strictness_allowed": [
        {
          "conjunct": "safe_for_agent_false",
          "present_when": {
            "response.safe_for_agent": false
          },
          "absence_case_id": "AA-BRANCH-CONTINUE"
        }
      ]
    },
    {
      "id": "AA-BRANCH-REQUEST-APPROVAL",
      "kind": "decide",
      "profiles": [
        "normative",
        "enforcement_consistent"
      ],
      "source": {
        "surface": "well-known",
        "path": "recommended_usage.execution_action",
        "assert": {
          "execution_action_includes": "REQUEST_APPROVAL"
        }
      },
      "input": {
        "response": {
          "decision": "REQUIRE_APPROVAL",
          "safe_for_agent": false,
          "execution_action": "REQUEST_APPROVAL"
        },
        "host": {
          "monitoringSinkWired": false
        }
      },
      "expect": {
        "outcome": "request_approval"
      },
      "class": "safety"
    },
    {
      "id": "AA-BRANCH-STOP",
      "kind": "decide",
      "profiles": [
        "normative",
        "enforcement_consistent"
      ],
      "source": {
        "surface": "well-known",
        "path": "recommended_usage.execution_action",
        "assert": {
          "execution_action_includes": "STOP"
        }
      },
      "input": {
        "response": {
          "decision": "BLOCK",
          "safe_for_agent": false,
          "execution_action": "STOP"
        },
        "host": {
          "monitoringSinkWired": false
        }
      },
      "expect": {
        "outcome": "halt"
      },
      "class": "safety"
    },
    {
      "id": "AA-UNRECOGNISED-ACTION",
      "kind": "decide",
      "profiles": [
        "normative"
      ],
      "source": {
        "surface": "well-known",
        "path": "recommended_usage.unrecognised_execution_action",
        "assert": {
          "unrecognised_execution_action": "not_permission_fail_closed"
        }
      },
      "input": {
        "response": {
          "decision": "ALLOW",
          "safe_for_agent": true,
          "execution_action": "PROCEED_ANYWAY"
        },
        "host": {
          "monitoringSinkWired": true
        }
      },
      "expect": {
        "outcome": "halt"
      },
      "class": "safety"
    },
    {
      "id": "AA-MISSING-EXECUTION-ACTION",
      "kind": "decide",
      "profiles": [
        "normative"
      ],
      "note": "v2 body with execution_action omitted and decision=ALLOW must halt (UNREADABLE / not permission). Missing action is not ALLOW. Must not map from decision.",
      "source": {
        "surface": "well-known",
        "path": "recommended_usage.unrecognised_execution_action",
        "assert": {
          "unrecognised_execution_action": "not_permission_fail_closed"
        }
      },
      "input": {
        "response": {
          "preflight_mode": "authorize",
          "decision_spec_version": "2.0",
          "decision": "ALLOW",
          "safe_for_agent": true
        },
        "host": {
          "monitoringSinkWired": true
        }
      },
      "expect": {
        "outcome": "halt"
      },
      "class": "safety"
    },
    {
      "id": "AA-MONITOR-SINK-WIRED",
      "kind": "decide",
      "profiles": [
        "normative",
        "enforcement_consistent"
      ],
      "source": {
        "surface": "well-known",
        "path": "recommended_usage.continue_with_monitoring_requires",
        "assert": {
          "continue_with_monitoring_requires": "monitoringSinkWired",
          "execution_action_includes": "CONTINUE_WITH_MONITORING"
        }
      },
      "input": {
        "response": {
          "decision": "WARN",
          "safe_for_agent": true,
          "execution_action": "CONTINUE_WITH_MONITORING"
        },
        "host": {
          "monitoringSinkWired": true
        }
      },
      "expect": {
        "outcome": "proceed_with_monitoring"
      },
      "class": "liveness",
      "strictness_allowed": [
        {
          "conjunct": "snippet_no_monitoring_sink",
          "present_when": {
            "response.execution_action": "CONTINUE_WITH_MONITORING"
          },
          "absence_case_id": "AA-BRANCH-CONTINUE"
        }
      ]
    },
    {
      "id": "AA-MONITOR-SINK-UNWIRED",
      "kind": "decide",
      "profiles": [
        "normative",
        "enforcement_consistent"
      ],
      "source": {
        "surface": "well-known",
        "path": "recommended_usage.continue_with_monitoring_requires",
        "assert": {
          "continue_with_monitoring_requires": "monitoringSinkWired"
        }
      },
      "input": {
        "response": {
          "decision": "WARN",
          "safe_for_agent": true,
          "execution_action": "CONTINUE_WITH_MONITORING"
        },
        "host": {
          "monitoringSinkWired": false
        }
      },
      "expect": {
        "outcome": "halt"
      },
      "class": "safety"
    },
    {
      "id": "AA-DOCS-ONLY-SKIP",
      "kind": "tool_selection",
      "profiles": [
        "normative"
      ],
      "source": {
        "surface": "mcp-tool-description",
        "path": "DESC_PREFLIGHT_CHANGE_SET Do not use when",
        "marker": "documentation-only"
      },
      "input": {
        "situation": "documentation_only_change",
        "change": {
          "kind": "documentation-only",
          "contract_artifacts_changed": false,
          "files": [
            "README.md",
            "docs/guide.md"
          ]
        },
        "held_receipt": null,
        "intended": null
      },
      "expect": {
        "tool": null
      },
      "class": "safety"
    },
    {
      "id": "AA-CONTRACT-CHANGE-PREFLIGHT",
      "kind": "tool_selection",
      "profiles": [
        "normative"
      ],
      "source": {
        "surface": "mcp-tool-description",
        "path": "DESC_PREFLIGHT_CHANGE_SET Use this when",
        "marker": "contract artifact"
      },
      "input": {
        "situation": "pending_contract_change",
        "change": {
          "kind": "contract",
          "contract_artifacts_changed": true,
          "files": [
            "openapi.yaml"
          ]
        },
        "held_receipt": null,
        "intended": {
          "operation": "merge",
          "target_id": "repo/main"
        }
      },
      "expect": {
        "tool": "preflight_change_set"
      },
      "class": "liveness"
    },
    {
      "id": "AA-RECEIPT-CARRY-VERIFY",
      "kind": "tool_selection",
      "profiles": [
        "normative"
      ],
      "source": {
        "surface": "mcp-tool-description",
        "path": "DESC_VERIFY_RECEIPT Use this when",
        "marker": "already obtained a chain_receipt"
      },
      "input": {
        "situation": "about_to_act_under_held_receipt",
        "change": {
          "kind": "none",
          "contract_artifacts_changed": false
        },
        "held_receipt": {
          "token": "test.receipt.token",
          "operation": "merge",
          "target_id": "repo/main"
        },
        "intended": {
          "operation": "merge",
          "target_id": "repo/main"
        }
      },
      "expect": {
        "tool": "verify_receipt"
      },
      "class": "liveness"
    },
    {
      "id": "AA-RECEIPT-WRONG-SCOPE-REPREFLIGHT",
      "kind": "tool_selection",
      "profiles": [
        "normative"
      ],
      "source": {
        "surface": "mcp-tool-description",
        "path": "DESC_PREFLIGHT_CHANGE_SET Use this when / DESC_VERIFY_RECEIPT Do not use when",
        "marker": "different operation or target"
      },
      "input": {
        "situation": "held_receipt_wrong_operation",
        "change": {
          "kind": "contract",
          "contract_artifacts_changed": true
        },
        "held_receipt": {
          "token": "test.receipt.token",
          "operation": "merge",
          "target_id": "repo/main"
        },
        "intended": {
          "operation": "deploy",
          "target_id": "repo/main"
        }
      },
      "expect": {
        "tool": "preflight_change_set"
      },
      "class": "liveness"
    },
    {
      "id": "AA-AUTHORIZE-NEEDS-OPERATION",
      "kind": "tool_selection",
      "profiles": [
        "normative"
      ],
      "note": "Discriminating cue: authorize path requires context.operation (MCP DESC_PREFLIGHT: authorize requires context.operation). Without a non-empty intended.operation, do not call preflight_change_set — operation is not optional for the authorize act. Distinct from AA-CONTRACT-CHANGE-PREFLIGHT (which has operation=merge).",
      "source": {
        "surface": "mcp-tool-description",
        "path": "DESC_PREFLIGHT_CHANGE_SET Mode authorize",
        "marker": "requires context.operation"
      },
      "input": {
        "situation": "contract_change_authorize_missing_operation",
        "change": {
          "kind": "contract",
          "contract_artifacts_changed": true,
          "files": [
            "openapi.yaml"
          ]
        },
        "held_receipt": null,
        "intended": {
          "target_id": "repo/main"
        }
      },
      "expect": {
        "tool": null
      },
      "class": "safety"
    },
    {
      "id": "EG-VALID",
      "kind": "execution_grant",
      "profiles": ["execution_grant"],
      "note": "Valid cr.exec.v1 grant verifies GRANT_CURRENT. Format: docs/cr-exec-v1.md.",
      "source": { "surface": "docs", "path": "docs/cr-exec-v1.md" },
      "input": {
        "scenario": "valid",
        "operation": "merge",
        "target_id": "sha256:tgt",
        "audience": "v:deadbeefdead",
        "after_payload": "{\"ok\":true}"
      },
      "expect": { "valid": true, "status": "GRANT_CURRENT" },
      "class": "safety"
    },
    {
      "id": "EG-EXPIRED",
      "kind": "execution_grant",
      "profiles": ["execution_grant"],
      "note": "exp in the past beyond leeway → GRANT_EXPIRED.",
      "source": { "surface": "docs", "path": "docs/cr-exec-v1.md" },
      "input": {
        "scenario": "expired",
        "operation": "merge",
        "target_id": "sha256:tgt",
        "audience": "v:deadbeefdead",
        "after_payload": "{\"ok\":true}"
      },
      "expect": { "valid": false, "status": "GRANT_EXPIRED" },
      "class": "safety"
    },
    {
      "id": "EG-WRONG-AUDIENCE",
      "kind": "execution_grant",
      "profiles": ["execution_grant"],
      "note": "intended.audience differs from signed audience → GRANT_WRONG_AUDIENCE.",
      "source": { "surface": "docs", "path": "docs/cr-exec-v1.md" },
      "input": {
        "scenario": "wrong_audience",
        "operation": "merge",
        "target_id": "sha256:tgt",
        "audience": "v:deadbeefdead",
        "after_payload": "{\"ok\":true}"
      },
      "expect": { "valid": false, "status": "GRANT_WRONG_AUDIENCE" },
      "class": "safety"
    },
    {
      "id": "EG-SCOPE-MISMATCH",
      "kind": "execution_grant",
      "profiles": ["execution_grant"],
      "note": "1-byte after-payload change recomputes a different scope_hash → GRANT_SCOPE_MISMATCH.",
      "source": { "surface": "docs", "path": "docs/cr-exec-v1.md" },
      "input": {
        "scenario": "scope_mismatch",
        "operation": "merge",
        "target_id": "sha256:tgt",
        "audience": "v:deadbeefdead",
        "after_payload": "{\"ok\":true}"
      },
      "expect": { "valid": false, "status": "GRANT_SCOPE_MISMATCH" },
      "class": "safety"
    },
    {
      "id": "EG-UNBOUND-DIGEST",
      "kind": "execution_grant",
      "profiles": ["execution_grant"],
      "note": "intended.receipt_token whose digest is not the signed receipt_digest → GRANT_UNBOUND.",
      "source": { "surface": "docs", "path": "docs/cr-exec-v1.md" },
      "input": {
        "scenario": "unbound_digest",
        "operation": "merge",
        "target_id": "sha256:tgt",
        "audience": "v:deadbeefdead",
        "after_payload": "{\"ok\":true}"
      },
      "expect": { "valid": false, "status": "GRANT_UNBOUND" },
      "class": "safety"
    },
    {
      "id": "EG-A-VALID",
      "kind": "execution_attestation",
      "profiles": ["execution_attestation"],
      "note": "Valid cr.exec.attest.v1 verifies ATTEST_VALID. Format: docs/cr-exec-attest-v1.md.",
      "source": { "surface": "docs", "path": "docs/cr-exec-attest-v1.md" },
      "input": { "scenario": "valid" },
      "expect": { "valid": true, "status": "ATTEST_VALID" },
      "class": "safety"
    },
    {
      "id": "EG-A-BAD-SIG",
      "kind": "execution_attestation",
      "profiles": ["execution_attestation"],
      "note": "Flipped signature byte → ATTEST_INVALID_SIGNATURE.",
      "source": { "surface": "docs", "path": "docs/cr-exec-attest-v1.md" },
      "input": { "scenario": "bad_sig" },
      "expect": { "valid": false, "status": "ATTEST_INVALID_SIGNATURE" },
      "class": "safety"
    },
    {
      "id": "EG-A-UNKNOWN-KID",
      "kind": "execution_attestation",
      "profiles": ["execution_attestation"],
      "note": "Registry does not contain executor_kid → ATTEST_UNKNOWN_KEY.",
      "source": { "surface": "docs", "path": "docs/cr-exec-attest-v1.md" },
      "input": { "scenario": "unknown_kid" },
      "expect": { "valid": false, "status": "ATTEST_UNKNOWN_KEY" },
      "class": "safety"
    },
    {
      "id": "EG-A-RETIRED-KEY-VALID-AT-ISSUE",
      "kind": "execution_attestation",
      "profiles": ["execution_attestation"],
      "note": "Retired executor kid + committed_at inside [valid_from, retired_at) PASSES as historical (receipt class, NOT the grant UNKNOWN_KEY rule).",
      "source": { "surface": "docs", "path": "docs/cr-exec-attest-v1.md" },
      "input": { "scenario": "retired_key_valid_at_issue" },
      "expect": { "valid": true, "status": "ATTEST_RETIRED_KEY_VALID_AT_ISSUE" },
      "class": "safety"
    },
    {
      "id": "EG-A-MALFORMED",
      "kind": "execution_attestation",
      "profiles": ["execution_attestation"],
      "note": "Not a four-segment tagged envelope → ATTEST_MALFORMED.",
      "source": { "surface": "docs", "path": "docs/cr-exec-attest-v1.md" },
      "input": { "scenario": "malformed" },
      "expect": { "valid": false, "status": "ATTEST_MALFORMED" },
      "class": "safety"
    },
    {
      "id": "EG-A-UNBOUND-JTI",
      "kind": "execution_attestation",
      "profiles": ["execution_attestation"],
      "note": "intended.grant_fields.jti differs from signed grant_jti → ATTEST_UNBOUND.",
      "source": { "surface": "docs", "path": "docs/cr-exec-attest-v1.md" },
      "input": { "scenario": "unbound_jti" },
      "expect": { "valid": false, "status": "ATTEST_UNBOUND" },
      "class": "safety"
    },
    {
      "id": "EG-A-STATE-NONCE-MISMATCH",
      "kind": "execution_attestation",
      "profiles": ["execution_attestation"],
      "note": "ATOMIC grant state_nonce differs from attestation state_nonce → ATTEST_UNBOUND.",
      "source": { "surface": "docs", "path": "docs/cr-exec-attest-v1.md" },
      "input": { "scenario": "state_nonce_mismatch" },
      "expect": { "valid": false, "status": "ATTEST_UNBOUND" },
      "class": "safety"
    }
  ]
}
